{
  "rewrites": [
    {
      "source": "/noticias-sitemap.xml",
      "destination": "/api/discovery?format=news"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/discovery?format=rss"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/noticia/:id",
      "destination": "/api/article?id=:id"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/login",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bi-para-todosbi-para-todos-2026.vercel.app"
        }
      ],
      "destination": "https://www.jingolokela.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bi-para-todosbi-para-todos-2026.vercel.app"
        }
      ],
      "destination": "https://www.jingolokela.com/:path*",
      "statusCode": 301
    }
  ]
}
